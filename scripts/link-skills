#!/usr/bin/env zsh
set -euo pipefail

repo_dir="${0:A:h:h}"
skills_dir="$repo_dir/skills"
dry_run=0
if [ "${1:-}" = "--dry-run" ]; then
  dry_run=1
fi

timestamp="$(date +%Y%m%d-%H%M%S)"
backup_root="$HOME/.codex/skill-backups/$timestamp"

roots=(
  "$HOME/.claude/skills"
  "$HOME/.qwen/skills"
  "$HOME/.pi/agent/skills"
  "$HOME/.cursor-homes/jb/.cursor/skills"
  "$HOME/.cursor-homes/ks/.cursor/skills"
)

codex_roots=(
  "$HOME/.codex/skills"
)

facade_roots=(
  "$HOME/.config/opencode/skills"
)

default_names=("${(@f)$(cat "$repo_dir/manifests/default-linked.txt")}")
optional_names=("${(@f)$(cat "$repo_dir/manifests/optional.txt")}")
removed_names=("${(@f)$(cat "$repo_dir/manifests/removed.txt")}")

run() {
  if [ "$dry_run" -eq 1 ]; then
    printf 'DRY %q ' "$@"
    printf '\n'
  else
    "$@"
  fi
}

backup_path() {
  local item="$1"
  local rel="${item#$HOME/}"
  local dest="$backup_root/$rel"
  run mkdir -p "${dest:h}"
  run mv "$item" "$dest"
}

link_root_skill() {
  local root="$1"
  local name="$2"
  local target="$root/$name"
  local source="$skills_dir/$name"
  run mkdir -p "$root"
  if [ -e "$target" ] || [ -L "$target" ]; then
    if [ -L "$target" ] && [ "$(readlink "$target")" = "$source" ]; then
      return
    fi
    backup_path "$target"
  fi
  run ln -s "$source" "$target"
}

remove_root_skill() {
  local root="$1"
  local name="$2"
  local target="$root/$name"
  if [ -e "$target" ] || [ -L "$target" ]; then
    backup_path "$target"
  fi
}

link_skill_facade() {
  local root="$1"
  run mkdir -p "${root:h}"
  if [ -e "$root" ] || [ -L "$root" ]; then
    if [ -L "$root" ] && [ "$(readlink "$root")" = "$agents_root" ]; then
      return
    fi
    backup_path "$root"
  fi
  run ln -s "$agents_root" "$root"
}

# Make ~/.agents/skills the shared facade with default-linked skills only.
agents_root="$HOME/.agents/skills"
if [ -e "$agents_root" ] || [ -L "$agents_root" ]; then
  if [ -L "$agents_root" ]; then
    backup_path "$agents_root"
  fi
fi
if [ ! -e "$agents_root" ]; then
  run mkdir -p "$HOME/.agents"
  run mkdir -p "$agents_root"
fi

# Agents that need their own skill root get per-skill symlinks. Their .system dirs are left alone.
for root in "$agents_root" "${roots[@]}"; do
  for name in "${default_names[@]}"; do
    link_root_skill "$root" "$name"
  done
  for name in "${optional_names[@]}"; do
    remove_root_skill "$root" "$name"
  done
  for name in "${removed_names[@]}"; do
    remove_root_skill "$root" "$name"
  done
  if [ -f "$root/SKILL.md" ]; then
    backup_path "$root/SKILL.md"
  fi
done

for root in "${facade_roots[@]}"; do
  link_skill_facade "$root"
done

# Codex can read ~/.agents/skills; remove duplicated non-system skill dirs from its own root.
for root in "${codex_roots[@]}"; do
  for name in "${default_names[@]}" "${optional_names[@]}" "${removed_names[@]}"; do
    remove_root_skill "$root" "$name"
  done
done

printf 'backup_root=%s\n' "$backup_root"
